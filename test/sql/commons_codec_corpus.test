# name: test/sql/commons_codec_corpus.test
# description: cross-check both functions against Apache Commons Codec over the committed corpus
# group: [duckdb_rphonetic]
#
# test/corpus/names.txt is the corpus; test/corpus/commons-codec.tsv holds the
# output of Apache Commons Codec 1.22.1 for every name in it, regenerated by
# test/oracle/run.sh. The extension is built on the `rphonetic` crate, a Rust
# port of those same two encoders, so the two should agree.
#
# They agree exactly for Daitch-Mokotoff. They disagree for Kölner Phonetik on
# a minority of inputs, because the two implementations collapse repeated codes
# differently; test/corpus/cologne-divergences.tsv lists every such input, and
# the README section "Cologne dedupe behaviour" explains the mechanism.

require duckdb_rphonetic

# Sanity: the corpus was found and is not empty. Everything below is a
# count-of-mismatches assertion, which a missing file would also satisfy.
query TT
SELECT count(*) > 200, count(*) = count(DISTINCT name)
FROM read_csv('test/corpus/commons-codec.tsv', delim='\t', header=true, quote='',
              columns={'name': 'VARCHAR', 'cologne': 'VARCHAR', 'daitch_mokotoff': 'VARCHAR'});
----
true	true

# --- Daitch-Mokotoff: exact agreement, no exceptions ------------------------
# Commons Codec's soundex() returns the codes pipe-joined; we join our list the
# same way, so this compares both the values and their order.
query I
SELECT count(*)
FROM read_csv('test/corpus/commons-codec.tsv', delim='\t', header=true, quote='',
              columns={'name': 'VARCHAR', 'cologne': 'VARCHAR', 'daitch_mokotoff': 'VARCHAR'})
WHERE list_aggregate(daitch_mokotoff(name), 'string_agg', '|') IS DISTINCT FROM daitch_mokotoff;
----
0

# --- Kölner Phonetik: agreement except for the listed divergences -----------
# For every name, this build must produce Commons Codec's code, unless the name
# appears in cologne-divergences.tsv, in which case it must produce exactly the
# value recorded there. Both a new divergence and a change to a recorded one
# fail here, so a `rphonetic` upgrade cannot silently move the output.
#
# An empty Cologne code is written as an empty TSV field, which read_csv reads
# back as NULL, hence the coalesce.
query I
SELECT count(*)
FROM read_csv('test/corpus/commons-codec.tsv', delim='\t', header=true, quote='',
              columns={'name': 'VARCHAR', 'cologne': 'VARCHAR', 'daitch_mokotoff': 'VARCHAR'}) o
LEFT JOIN read_csv('test/corpus/cologne-divergences.tsv', delim='\t', header=true, quote='',
                   columns={'name': 'VARCHAR', 'commons_codec': 'VARCHAR', 'rphonetic': 'VARCHAR'}) d
  USING (name)
WHERE cologne_phonetic(o.name) IS DISTINCT FROM coalesce(d.rphonetic, o.cologne, '');
----
0

# The divergence list must not accumulate stale rows. Every one of its 36 names
# must be in the corpus (so the join keeps all of them), its commons_codec
# column must still match what Commons Codec actually produces, and it must
# record a genuine disagreement rather than two equal values.
query III
SELECT count(*),
       count(*) FILTER (WHERE d.commons_codec IS NOT DISTINCT FROM coalesce(o.cologne, '')),
       count(*) FILTER (WHERE d.rphonetic IS DISTINCT FROM d.commons_codec)
FROM read_csv('test/corpus/cologne-divergences.tsv', delim='\t', header=true, quote='',
              columns={'name': 'VARCHAR', 'commons_codec': 'VARCHAR', 'rphonetic': 'VARCHAR'}) d
JOIN read_csv('test/corpus/commons-codec.tsv', delim='\t', header=true, quote='',
              columns={'name': 'VARCHAR', 'cologne': 'VARCHAR', 'daitch_mokotoff': 'VARCHAR'}) o
  USING (name);
----
36	36	36
